# ─────────────────────────────────────────────────────────────────────────────
# AI SQL Assistant — Environment Variables
# Copy this file to .env, then fill in your real values.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Password used by the app user (aisql_app)
DB_PASSWORD=dev_password

# Password for the read-only query role (aisql_query)
QUERY_DB_PASSWORD=query_password

# Ports exposed on the host
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: groq | nvidia | openrouter | gemini | openai
LLM_PROVIDER=groq

# ── API Keys (only the one matching LLM_PROVIDER is required) ────────────────
GROQ_API_KEY=gsk_your_groq_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENAI_API_KEY=sk-your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── App settings ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
QUERY_TIMEOUT_SECONDS=30
RATE_LIMIT=60/minute

# ── Debug / Logging ───────────────────────────────────────────────────────────
# Set DEBUG=true to enable /docs and /redoc in the backend
DEBUG=false
LOG_LEVEL=INFO
